# =========================================================
# Personal Productivity OS - Environment Configuration
# =========================================================

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/personal_os?retryWrites=true&w=majority
# Or local MongoDB: mongodb://localhost:27017/personal_os
MONGODB_URI=mongodb://localhost:27017/personal_os

# Firebase Client Configuration (From Firebase Console > Project Settings > Web App)
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Firebase Admin SDK Configuration (From Firebase Console > Project Settings > Service Accounts)
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your_project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Development / Demo Mode Toggle
# When true, allows instant zero-setup local testing with realistic demo account and seed data
NEXT_PUBLIC_ENABLE_DEMO_MODE=true

# Optional AI Integration (Google Gemini API Key)
# Core logic works 100% deterministically without AI; AI is used purely for optional Brain Dump enhancement
GEMINI_API_KEY=
